ndicative auto","q":"OT","big":1,"a":"Olt","d":"Reședință: Slatina","jud":"OT","alt":["Olt"]},{"id":"jud-auto-ph","sub":"Indicative auto","q":"PH","big":1,"a":"Prahova","d":"Reședință: Ploiești","jud":"PH","alt":["Prahova"]},{"id":"jud-auto-sb","sub":"Indicative auto","q":"SB","big":1,"a":"Sibiu","d":"Reședință: Sibiu","jud":"SB","alt":["Sibiu"]},{"id":"jud-auto-sj","sub":"Indicative auto","q":"SJ","big":1,"a":"Sălaj","d":"Reședință: Zalău","jud":"SJ","alt":["Sălaj"]},{"id":"jud-auto-sm","sub":"Indicative auto","q":"SM","big":1,"a":"Satu Mare","d":"Reședință: Satu Mare","jud":"SM","alt":["Satu Mare"]},{"id":"jud-auto-sv","sub":"Indicative auto","q":"SV","big":1,"a":"Suceava","d":"Reședință: Suceava","jud":"SV","alt":["Suceava"]},{"id":"jud-auto-tl","sub":"Indicative auto","q":"TL","big":1,"a":"Tulcea","d":"Reședință: Tulcea","jud":"TL","alt":["Tulcea"]},{"id":"jud-auto-tm","sub":"Indicative auto","q":"TM","big":1,"a":"Timiș","d":"Reședință: Timișoara","jud":"TM","alt":["Timiș"]},{"id":"jud-auto-tr","sub":"Indicative auto","q":"TR","big":1,"a":"Teleorman","d":"Reședință: Alexandria","jud":"TR","alt":["Teleorman"]},{"id":"jud-auto-vl","sub":"Indicative auto","q":"VL","big":1,"a":"Vâlcea","d":"Reședință: Râmnicu Vâlcea","jud":"VL","alt":["Vâlcea"]},{"id":"jud-auto-vn","sub":"Indicative auto","q":"VN","big":1,"a":"Vrancea","d":"Reședință: Focșani","jud":"VN","alt":["Vrancea"]},{"id":"jud-auto-vs","sub":"Indicative auto","q":"VS","big":1,"a":"Vaslui","d":"Reședință: Vaslui","jud":"VS","alt":["Vaslui"]},{"id":"jud-riv-dunarea","sub":"Râuri","q":"","rl":"r:Dunărea","a":"Dunărea","d":"Fluviu. Izvorăște din Munții Pădurea Neagră (Germania) și se varsă în Marea Neagră prin Delta Dunării. Al doilea fluviu ca lungime din Europa, după Volga.","f":{"Lungime totală":"aprox. 2.857 km","În România":"aprox. 1.075 km (inclusiv granița)","Se varsă în":"Marea Neagră"},"en":"Danube"},{"id":"jud-riv-mures","sub":"Râuri","q":"","rl":"r:Mureș","a":"Mureș","d":"Izvorăște din Munții Hășmaș (Harghita), străbate Transilvania și se varsă în Tisa, în Ungaria, la Szeged. Este cel mai lung râu interior al României.","f":{"Lungime în România":"aprox. 761 km","Izvor":"Munții Hășmaș","Se varsă în":"Tisa (Ungaria)","Orașe":"Târgu Mureș, Alba Iulia, Deva, Arad"},"en":"Mureș River"},{"id":"jud-riv-olt","sub":"Râuri","q":"","rl":"r:Olt","a":"Olt","d":"Izvorăște tot din Munții Hășmaș, ca Mureșul, dar curge spre sud: taie Carpații Meridionali prin defileul Turnu Roșu-Cozia și se varsă în Dunăre la Turnu Măgurele.","f":{"Lungime":"aprox. 615 km","Izvor":"Munții Hășmaș","Se varsă în":"Dunăre","Orașe":"Sfântu Gheorghe, Râmnicu Vâlcea, Slatina"},"en":"Olt River"},{"id":"jud-riv-prut","sub":"Râuri","q":"","rl":"r:Prut","a":"Prut","d":"Izvorăște din Ucraina (Carpații Păduroși) și formează granița cu Republica Moldova. Se varsă în Dunăre, lângă Galați.","f":{"Lungime totală":"aprox. 953 km","Pe granița României":"aprox. 742 km","Se varsă în":"Dunăre"},"en":"Prut River"},{"id":"jud-riv-siret","sub":"Râuri","q":"","rl":"r:Siret","a":"Siret","d":"Izvorăște din Ucraina și străbate Moldova de la nord la sud. Are cel mai mare bazin hidrografic din România. Se varsă în Dunăre, lângă Galați.","f":{"Lungime totală":"aprox. 726 km","În România":"aprox. 559 km","Afluenți":"Suceava, Moldova, Bistrița, Trotuș, Buzău"},"en":"Siret River"},{"id":"jud-riv-ialomita","sub":"Râuri","q":"","rl":"r:Ialomița","a":"Ialomița","d":"Izvorăște din Munții Bucegi, de lângă Peștera Ialomiței, traversează Câmpia Română și se varsă în Dunăre.","f":{"Lungime":"aprox. 417 km","Izvor":"Munții Bucegi","Orașe":"Târgoviște, Slobozia"},"en":"Ialomița River"},{"id":"jud-riv-arges","sub":"Râuri","q":"","rl":"r:Argeș","a":"Argeș","d":"Izvorăște din Munții Făgăraș. Pe el se află barajul și lacul Vidraru, iar Transfăgărășanul urcă pe valea lui. Se varsă în Dunăre la Oltenița.","f":{"Lungime":"aprox. 350 km","Izvor":"Munții Făgăraș","Lac de acumulare":"Vidraru","Orașe":"Curtea de Argeș, Pitești"},"en":"Argeș River"},{"id":"jud-riv-jiu","sub":"Râuri","q":"","rl":"r:Jiu","a":"Jiu","d":"Se formează la Petroșani din Jiul de Est și Jiul de Vest, taie Carpații prin Defileul Jiului și se varsă în Dunăre.","f":{"Lungime":"aprox. 339 km","Orașe":"Petroșani, Târgu Jiu, Craiova"},"en":"Jiu River"},{"id":"jud-riv-buzau","sub":"Râuri","q":"","rl":"r:Buzău","a":"Buzău","d":"Izvorăște din Carpații de Curbură și se varsă în Siret.","f":{"Se varsă în":"Siret","Orașe":"Buzău"},"en":"Buzău River"},{"id":"jud-riv-bistrita","sub":"Râuri","q":"","rl":"r:Bistrița","a":"Bistrița","d":"Izvorăște din Munții Rodnei. Pe ea se află barajul de la Bicaz și Lacul Izvorul Muntelui. Se varsă în Siret, lângă Bacău.","f":{"Se varsă în":"Siret","Lac de acumulare":"Izvorul Muntelui (Bicaz)","Orașe":"Vatra Dornei, Piatra Neamț, Bacău"},"en":"Bistrița River (Siret)"},{"id":"jud-riv-somesul-mare","sub":"Râuri","q":"","rl":"r:Someșul Mare","a":"Someșul Mare","d":"Izvorăște din Munții Rodnei. La Dej se unește cu Someșul Mic și formează Someșul, care se varsă în Tisa, în Ungaria.","f":{"Izvor":"Munții Rodnei","Confluență":"cu Someșul Mic, la Dej"},"en":"Someșul Mare River"},{"id":"jud-riv-crisul-repede","sub":"Râuri","q":"","rl":"r:Crișul Repede","a":"Crișul Repede","d":"Izvorăște din județul Cluj, trece prin Oradea și continuă în Ungaria.","f":{"Orașe":"Huedin (aproape), Oradea","Continuă în":"Ungaria"},"en":"Crișul Repede River"},{"id":"jud-riv-crisul-alb","sub":"Râuri","q":"","rl":"r:Crișul Alb","a":"Crișul Alb","d":"Izvorăște din Munții Apuseni, trece prin Brad și Ineu și continuă în Ungaria.","f":{"Orașe":"Brad, Ineu","Continuă în":"Ungaria"},"en":"Crișul Alb River"},{"id":"jud-riv-timis","sub":"Râuri","q":"","rl":"r:Timiș","a":"Timiș","d":"Izvorăște din Munții Semenic, trece prin Caransebeș și Lugoj și se varsă în Dunăre, în Serbia. Atenție: Timișoara nu e pe Timiș, ci pe Bega.","f":{"Izvor":"Munții Semenic","Orașe":"Caransebeș, Lugoj","Se varsă în":"Dunăre (Serbia)"},"en":"Timiș River"},{"id":"jud-riv-trotus","sub":"Râuri","q":"","rl":"r:Trotuș","a":"Trotuș","d":"Izvorăște din Munții Ciucului, trece prin Comănești și Onești și se varsă în Siret.","f":{"Se varsă în":"Siret","Orașe":"Comănești, Onești"},"en":"Trotuș River"},{"id":"jud-riv-moldova","sub":"Râuri","q":"","rl":"r:Moldova","a":"Moldova","d":"Râul care a dat numele regiunii istorice. Izvorăște din Obcinele Bucovinei și se varsă în Siret, lângă Roman.","f":{"Se varsă în":"Siret","Orașe":"Câmpulung Moldovenesc, Roman"},"en":"Moldova River"},{"id":"jud-riv-vedea","sub":"Râuri","q":"","rl":"r:Vedea","a":"Vedea","d":"Izvorăște din Podișul Getic, trece prin Alexandria și se varsă în Dunăre.","f":{"Se varsă în":"Dunăre","Orașe":"Alexandria"},"en":"Vedea River"},{"id":"jud-riv-tisa","sub":"Râuri","q":"","rl":"r:Tisa","a":"Tisa","d":"Izvorăște din Ucraina și formează granița României cu Ucraina în nordul Maramureșului. Este cel mai lung afluent al Dunării.","f":{"Lungime totală":"aprox. 966 km","Se varsă în":"Dunăre (Serbia)"},"en":"Tisza River"},{"id":"jud-riv-bratul-chilia","sub":"Râuri","q":"","rl":"r:Brațul Chilia","a":"Brațul Chilia","d":"Cel mai nordic braț al Dunării în Deltă și cel cu cel mai mare debit; formează granița cu Ucraina.","f":{"Poziție":"nord","Particularitate":"cel mai mare debit"},"en":"Chilia branch"},{"id":"jud-riv-bratul-sulina","sub":"Râuri","q":"","rl":"r:Brațul Sulina","a":"Brațul Sulina","d":"Brațul din mijloc, cel mai scurt; a fost rectificat pentru navigație. La vărsare se află orașul Sulina.","f":{"Poziție":"centru","Particularitate":"cel mai scurt, navigabil"},"en":"Sulina branch"},{"id":"jud-riv-bratul-sfantu-gheorghe","sub":"Râuri","q":"","rl":"r:Brațul Sfântu Gheorghe","a":"Brațul Sfântu Gheorghe","d":"Cel mai sudic braț al Dunării în Deltă, cu multe meandre.","f":{"Poziție":"sud","Particularitate":"cel mai sudic"},"en":"Saint George branch"},{"id":"jud-pk-moldoveanu","sub":"Munți","q":"","rl":"p:Moldoveanu","a":"Munții Făgăraș","alt":["Moldoveanu","Făgăraș"],"d":"Vârful marcat: Moldoveanu, 